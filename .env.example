# Copy to /etc/zhiyu.env on the server; never commit real values.
# Use a dedicated database account. Percent-encode special characters in URL credentials.
DATABASE_URL=mysql+pymysql://DB_USER:URL_ENCODED_PASSWORD@127.0.0.1:3306/chinese_study?charset=utf8mb4
ZHIYU_ADMIN_USER=teacher
ZHIYU_ADMIN_PASSWORD=REPLACE_WITH_A_NEW_RANDOM_PASSWORD
PUBLIC_ORIGIN=https://YOUR_DOMAIN
COOKIE_SECURE=true
# Optional: OpenAI-compatible AI service. Keep these unset to use built-in/published analyses only.
# ZHIYU_AI_BASE_URL=https://YOUR_PROVIDER/v1
# ZHIYU_AI_MODEL=YOUR_MODEL
# ZHIYU_AI_API_KEY=
